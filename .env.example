# Settings for tools/pvelab, the Proxmox hardware lab
# (docs/development/proxmox-lab.md). Copy to .env, which git ignores, and
# fill in the real values there. Never put real values in this file.

# Proxmox API
PVE_HOST=pve.example.invalid
PVE_PORT=8006
PVE_NODE=pve01

# API token. Keep the secret only in .env, never in this example.
PVE_TOKEN_ID=goos-ci@pve!goos-lab
PVE_TOKEN_SECRET=

# TLS. A node with its own Proxmox CA needs that CA here:
# /etc/pve/pve-root-ca.pem on the node. PVE_TLS_INSECURE=1 turns the check
# off and is for emergencies only.
PVE_CA_FILE=
PVE_TLS_INSECURE=0

# SSH to the node, for disk import and the serial console
PVE_SSH_HOST=pve.example.invalid
PVE_SSH_PORT=22
PVE_SSH_USER=root
PVE_SSH_KEY=~/.ssh/id_ed25519
# auto: run qm, socat, and pvesm through sudo -n when PVE_SSH_USER is not root
PVE_SSH_SUDO=auto

# Proxmox resources
PVE_POOL=goos-lab
PVE_DISK_STORAGE=local-lvm
PVE_ISO_STORAGE=local
PVE_EFI_STORAGE=local-lvm

# VM defaults
PVE_MACHINE=q35
PVE_BIOS=ovmf
PVE_CPU=host
PVE_SOCKETS=1
PVE_CORES=1
PVE_MEMORY=1024

# Runner. PVE_TIMEOUT bounds the time from VM start to the shell prompt.
PVE_TIMEOUT=180s
PVE_KEEP_VM=0
PVE_MAX_PARALLEL=1
